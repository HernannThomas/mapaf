# SCADA SENA-CIES — Apache .htaccess para XAMPP
# ================================================
# Coloca este archivo en: C:/xampp/htdocs/scada/.htaccess
#
# Requisitos:
#   - Apache con mod_rewrite habilitado (viene activado en XAMPP por defecto)
#   - PHP con extensión cURL habilitada en php.ini

Options -Indexes
Options +FollowSymLinks

RewriteEngine On
RewriteBase /scada/

# ─── Proxy de API: redirige /scada/api/* al proxy PHP ──────────────────
# Todas las llamadas a /api/* se redirigen al proxy que habla con Python
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api/(.*)$ api_proxy.php?_path=/api/$1 [QSA,L]

# ─── SPA React: redirige todo lo demás a index.html ────────────────────
# React Router necesita que todas las rutas desconocidas carguen index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.html [L]
